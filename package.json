{
  "name": "grosshandel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant B2B Grosshandel-Plattform auf Cloudflare Workers",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:customer": "tsx scripts/smoke-customer.ts",
    "smoke:login": "tsx scripts/smoke-login.ts",
    "stress:stock": "tsx scripts/stress-stock.ts",
    "load": "tsx scripts/load-test.ts",
    "seed:pilot": "tsx scripts/seed-pilot.ts",
    "bootstrap-tenant": "tsx scripts/bootstrap-tenant.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "pdf-lib": "^1.17.1",
    "ulid": "^2.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "2.1.9",
    "wrangler": "^4.86.0"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "shell-quote": ">=1.9.0"
    }
  }
}
