# ─── Grosshandel: Secrets-Vorlage ───────────────────────────────────────────
# Setzen via wrangler secret put <NAME> [--env staging|production]
# NICHT in .dev.vars in Production-Branch committen.

# ── E-Mail (M02b Magic-Link via Cloudflare Email Service) ──
# Kein API-Schlüssel: der Worker sendet über das Binding `send_email` (EMAIL,
# steht in wrangler.toml). Die Absenderadresse ist eine Worker-Variable, ihre
# Domain muss im Konto für Email Sending freigeschaltet sein:
#   wrangler email sending list
#   wrangler secret put MAIL_FROM --env staging
MAIL_FROM=login@pilot.example

# ── External Services ──
VIES_PROXY_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

# ── APNs / FCM (M23) ──
# Plan-Revision: real Adapter sind noch nicht aktiv.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_KEY=

# ── Pricing-Feeds (M20) ──
AALSMEER_API_KEY=
RBC_API_KEY=

# ── Build-Time vars (im wrangler.toml [vars]-Block, kein Secret) ──
# WORKER_VERSION wird vom CI gesetzt
# GIT_COMMIT wird vom CI gesetzt
